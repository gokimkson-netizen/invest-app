{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["packages/core/src/*"], "@config/*": ["config/*"] }
  },
  "include": ["packages/core/src", "web/src", "worker/src", "batch/calc", "packages/core/test", "worker/test"]
}
